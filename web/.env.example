# Copy this file to .env.local and fill in real values. .env.local is
# gitignored -- never commit real credentials. See
# docs/engineering/environment.md for the full rule on what is and isn't
# safe to expose client-side.

# Supabase project URL and anon key (public-safe, gated by Row Level
# Security policies -- see docs/engineering/environment.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Once a real custom domain is pointed at the production
# deployment, set this to it (e.g. https://share.example.com) so every
# share link (the admin Share tab, the project page's own share popup)
# uses that instead of whatever URL the app happens to be running on --
# a Vercel preview URL, for example, which embeds the branch name and
# isn't something worth a client seeing. See
# docs/features/full-admin-dashboard.md and utils/publicUrl.ts.
VITE_PUBLIC_SITE_URL=

# NOT set here. Model/IFC file uploads go to Cloudflare R2 (api/r2-*.ts)
# -- those functions read R2_ACCOUNT_ID / R2_ACCESS_KEY_ID /
# R2_SECRET_ACCESS_KEY / R2_BUCKET_NAME / R2_PUBLIC_URL directly from
# Vercel's own server-side Project Settings → Environment Variables, not
# from this file or a VITE_ prefix -- they must never reach the browser
# bundle the way every var above this line does. See
# docs/features/large-file-storage.md for the full setup steps.
