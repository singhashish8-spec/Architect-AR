{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Matches how Vercel itself actually compiles api/*.ts (confirmed
       2026-08-12 from a real deployment's build log: "Relative import
       paths need explicit file extensions in ECMAScript imports when
       '--moduleResolution' is 'node16' or 'nodenext'") -- NOT bundler
       mode like tsconfig.app.json, even though these functions also get
       bundled by esbuild at deploy time. Using bundler mode here let
       extensionless relative imports (./_lib/r2) pass tsc -b locally
       while silently breaking at runtime once deployed, since this repo
       has "type": "module" and Vercel's own build step enforces real
       Node ESM resolution rules for these files specifically. Every
       relative import under api/ needs an explicit .js extension (even
       though the source file is .ts) as a result. */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Strict type-checking (docs/engineering/conventions.md: strict, no exceptions) */
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
